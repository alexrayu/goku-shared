{# Shared shell for the login and installer pages: centred card, stacked fields, public theme. #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <style>
        {{ include('theme/_base.css.twig') }}
        body { display: grid; place-items: center; align-content: center; gap: 1.5rem; min-height: 100vh; padding: 1rem; }
        .brand { display: flex; align-items: center; gap: .6rem; font-weight: 700; font-size: 1.15rem; }
        main { width: min(24rem, 100%); padding: 2rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: 0 12px 40px rgb(0 0 0 / .4); }
        h1 { margin: 0 0 .5rem; font-size: 1.5rem; }
        p { margin: 0 0 1rem; }
        form { display: grid; gap: .3rem; }
        label { margin-top: .75rem; color: var(--muted); font-weight: 600; font-size: .875rem; }
        input { padding: .6rem .75rem; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--text); font: inherit; }
        input:focus { outline: 2px solid var(--accent); outline-offset: -1px; border-color: transparent; }
        form .button { margin-top: 1.25rem; border-radius: 8px; }
        [role=alert] { margin: 0 0 .5rem; padding: .6rem .75rem; border: 1px solid #6b2a20; border-radius: 8px; background: #2a1512; color: #ffb4a6; }
        .problems { display: grid; gap: .5rem; margin: 0; padding-left: 1.2rem; }
        .env { overflow-x: auto; margin: 0 0 .5rem; padding: .6rem .75rem; border-radius: 8px; background: var(--raised); font-size: .8rem; white-space: pre-wrap; word-break: break-all; }
        code { padding: .1rem .3rem; border-radius: 4px; background: var(--raised); font-size: .85em; }
    </style>
{% endblock %}

{% block body %}
    {{ include('theme/_brand.html.twig') }}
    <main>{% block content %}{% endblock %}</main>
{% endblock %}
