{% extends 'auth_layout.html.twig' %}

{% block title %}Update{% endblock %}

{% block content %}
    <h1>Update the site</h1>
    <p>The site is being updated and is back shortly.</p>

    {% if enabled %}
        <form method="post">
            <p>Site owner: this release changes the database. Back up the database first if your host offers it, then enter <code>UPDATE_TOKEN</code> from <code>.env.local</code>.</p>
            {% if error %}
                <pre role="alert" class="env">{{ error }}</pre>
            {% endif %}
            <label for="token">Update token</label>
            <input type="password" id="token" name="token" required autocomplete="off">
            <button class="button primary" type="submit">Update the database</button>
        </form>
    {% else %}
        <p>Site owner: add <code>UPDATE_TOKEN=</code> with a long random value to <code>.env.local</code>, then reload this page.</p>
    {% endif %}
{% endblock %}
