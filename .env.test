# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Keep test files out of the dev storage dir
STORAGE_PATH=%kernel.project_dir%/var/storage-test

# Dev compose database; doctrine.yaml appends _test to the name.
DATABASE_URL="mysql://app:app@database:3306/app?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
UPDATE_TOKEN=test-update-token
